{
  "name": "statushub-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "theme:generate": "node scripts/generate-theme.mjs",
    "predev": "npm run theme:generate",
    "prebuild": "npm run theme:generate",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:i18n && tsc -b && vite build && node scripts/compress.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src vite.config.ts"
  },
  "dependencies": {
    "@okramp/core": "0.3.0",
    "@okramp/tdesign": "0.1.0",
    "@tanstack/react-query": "^5.90.0",
    "i18next": "^26.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.9.0",
    "tdesign-icons-react": "^0.4.0",
    "tdesign-react": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
