POSTGRES_PORT=55432
POSTGRES_DB=statusmon
POSTGRES_USER=statusmon
POSTGRES_PASSWORD=statusmon_local_only
NATS_CLIENT_PORT=54222
NATS_MONITOR_PORT=58222
AWS_REGION=us-east-1
STATUSMON_REGION=local
STATUSMON_HTML_RECIPES_FILE=
# Generate independently: openssl rand -base64 32
STATUSMON_CONFIG_KEY=
STATUSMON_CONFIG_KEY_ID=local-v1
# Generate independently: openssl rand -base64 32
STATUSMON_API_KEY=
# Local HTTP requires statusmon-api -allow-http-oidc; production must use HTTPS.
STATUSMON_API_ADDRESS=127.0.0.1:8080
STATUSMON_PUBLIC_URL=http://127.0.0.1:8080

# Identity email (separate from incident notification endpoints)
STATUSMON_SMTP_ADDRESS=
STATUSMON_SMTP_FROM=statusmon@localhost
STATUSMON_SMTP_USERNAME=
STATUSMON_SMTP_PASSWORD=
STATUSMON_SMTP_ALLOW_LOCAL_PLAINTEXT=false
