POSTGRES_PORT=55432
POSTGRES_DB=statushub
POSTGRES_USER=statushub
POSTGRES_PASSWORD=statushub_local_only
NATS_CLIENT_PORT=54222
NATS_MONITOR_PORT=58222
AWS_REGION=us-east-1
STATUSHUB_REGION=local
STATUSHUB_HTML_RECIPES_FILE=
# Generate independently: openssl rand -base64 32
STATUSHUB_CONFIG_KEY=
STATUSHUB_CONFIG_KEY_ID=local-v1
# Generate independently: openssl rand -base64 32
STATUSHUB_API_KEY=
# Local HTTP requires statushub-api -allow-http-oidc; production must use HTTPS.
STATUSHUB_API_ADDRESS=127.0.0.1:8080
STATUSHUB_PUBLIC_URL=http://127.0.0.1:8080

# Identity email (separate from incident notification endpoints)
STATUSHUB_SMTP_ADDRESS=
STATUSHUB_SMTP_FROM=statushub@localhost
STATUSHUB_SMTP_USERNAME=
STATUSHUB_SMTP_PASSWORD=
STATUSHUB_SMTP_ALLOW_LOCAL_PLAINTEXT=false
