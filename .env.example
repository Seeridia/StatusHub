# Production configuration. Copy to .env on your server, or use your platform's
# secret environment editor. For local development use deploy/local.env.example.
# Set an existing published version or immutable digest; no implicit latest tag.
STATUSMON_IMAGE=ghcr.io/seeridia/vendor-status-monitoring:sha-<full-commit-sha>
# Generate with openssl rand -hex 32 (must be URL-safe).
POSTGRES_PASSWORD=
# Generate each key independently with openssl rand -base64 32.
STATUSMON_CONFIG_KEY=
STATUSMON_CONFIG_KEY_ID=production-v1
STATUSMON_API_KEY=
STATUSMON_REGION=production
STATUSMON_PUBLIC_URL=https://status.example.com
STATUSMON_SMTP_ADDRESS=smtp.example.com:587
STATUSMON_SMTP_FROM=status@example.com
STATUSMON_SMTP_USERNAME=
STATUSMON_SMTP_PASSWORD=
# Default: only a reverse proxy on this host can access the published port.
STATUSMON_BIND_ADDRESS=127.0.0.1
STATUSMON_HTTP_PORT=8080
