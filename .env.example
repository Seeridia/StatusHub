# Production configuration. Copy to .env on your server, or use your platform's
# secret environment editor. For local development use deploy/local.env.example.
# Set an existing published version or immutable digest; no implicit latest tag.
STATUSHUB_IMAGE=ghcr.io/seeridia/statushub:sha-<full-commit-sha>
# Generate with openssl rand -hex 32 (must be URL-safe).
POSTGRES_PASSWORD=
# Generate each key independently with openssl rand -base64 32.
STATUSHUB_CONFIG_KEY=
STATUSHUB_CONFIG_KEY_ID=production-v1
STATUSHUB_API_KEY=
STATUSHUB_REGION=production
STATUSHUB_PUBLIC_URL=https://status.example.com
STATUSHUB_SMTP_ADDRESS=smtp.example.com:587
STATUSHUB_SMTP_FROM=status@example.com
STATUSHUB_SMTP_USERNAME=
STATUSHUB_SMTP_PASSWORD=
# Default: only a reverse proxy on this host can access the published port.
STATUSHUB_BIND_ADDRESS=127.0.0.1
STATUSHUB_HTTP_PORT=8080
